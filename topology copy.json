      "host": "10.239.207.156",
      "runs": { "dispatcher": true, "db": "primary", "bo": ["bo-1"] }
    },
    "M1": {
      "host": "10.239.207.176",
      "runs": { "dispatcher": false, "db": null, "bo": ["bo-2"] }
    },
    "M2": {
      "host": "10.239.207.244",
      "runs": { "dispatcher": false, "db": null, "bo": ["bo-3"] }
    }
  },

  "dispatcher": { "host": "10.239.207.156", "port": 3000 },

  "db": {
    "primary": { "host": "10.239.207.156", "port": 5432 },
    "replicas": [
      { "host": "10.239.207.156", "port": 5433 }
    ]
  },

  "services": {
    "Criminal": [
      { "id": "bo-1", "host": "10.239.207.156", "port": 4001 },
      { "id": "bo-2", "host": "10.239.207.176", "port": 4001 },
      { "id": "bo-3", "host": "10.239.207.244", "port": 4001 }
    ]
  },

  "$example_single_machine": {
