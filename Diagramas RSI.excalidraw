    {
      "id": "gmEbZywCoG4IH3J1t1wT0",
      "type": "text",
      "x": 9207.848718906149,
      "y": -4472.30471079115,
      "width": 1031.0938553583078,
      "height": 1700.8928571428614,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
