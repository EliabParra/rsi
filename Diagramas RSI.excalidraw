      "isDeleted": false,
      "boundElements": [],
      "updated": 1780249783381,
      "link": null,
      "locked": false,
      "text": "service PersonaService {\n  rpc Create (Persona) returns\n(Response);\n  rpc Read (CiRequest) returns\n(Persona);\n  rpc Update (Persona) returns\n(Response);\n  rpc Delete (CiRequest) returns\n(Response);\n}\n\nmessage Persona {\n  int32 ci = 1;\n  string nombre = 2;\n  string apellido = 3;\n}",
      "fontSize": 27.285714285714278,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "service PersonaService {\n  rpc Create (Persona) returns (Response);\n  rpc Read (CiRequest) returns (Persona);\n  rpc Update (Persona) returns (Response);\n  rpc Delete (CiRequest) returns (Response);\n}\n\nmessage Persona {\n  int32 ci = 1;\n  string nombre = 2;\n  string apellido = 3;\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
