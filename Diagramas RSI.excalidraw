      "isDeleted": false,
      "boundElements": [],
      "updated": 1780249765132,
      "link": null,
      "locked": false,
      "text": "Client -> Dispatcher\n\nconst peticion = {\n    className: 'calculadora',\n    methodName: 'suma',\n    params: [...]\n}\n\n\nDispatcher -> Load Balancer\n\nconst payload = {\n    serverList: [\n        {\n            ip: 1.1.1.1\n            port: 1010\n        },\n        {\n            ip: 1.1.1.2\n            port: 1012\n        }\n    ],\n    className: 'calculadora',\n    methodName: 'suma', \n    params: [...]\n  }\n\n\nLoad Balancer -> BO Server\nrecibe payload\n\nmediante algoritmo determina a quien y en que orden manda la peticion\n\n[\n    {\n        rank: 1\n        ip: 1.1.1.1\n        port: 1010\n    },\n    {\n        rank: 2\n        ip: 1.1.1.2\n        port: 1012\n    }\n]",
      "fontSize": 30.238095238095315,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client -> Dispatcher\n\nconst peticion = {\n    className: 'calculadora',\n    methodName: 'suma',\n    params: [...]\n}\n\n\nDispatcher -> Load Balancer\n\nconst payload = {\n    serverList: [\n        {\n            ip: 1.1.1.1\n            port: 1010\n        },\n        {\n            ip: 1.1.1.2\n            port: 1012\n        }\n    ],\n    className: 'calculadora',\n    methodName: 'suma', \n    params: [...]\n  }\n\n\nLoad Balancer -> BO Server\nrecibe payload\n\nmediante algoritmo determina a quien y en que orden manda la peticion\n\n[\n    {\n        rank: 1\n        ip: 1.1.1.1\n        port: 1010\n    },\n    {\n        rank: 2\n        ip: 1.1.1.2\n        port: 1012\n    }\n]",
      "autoResize": true,
      "lineHeight": 1.25
    },
