      "type": "text",
      "x": 10639.87488092845,
      "y": -4533.253281651613,
      "width": 462.7128006292843,
      "height": 545.7142857142856,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
