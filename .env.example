# Shared local/LAN host fallback. For first Phase 5 smoke test, use the same machine IP.
RSI_HOST=192.168.0.10

# Dispatcher on M0
DISPATCHER_HOST=192.168.0.10
DISPATCHER_PORT=3000

# BO replicas.
# Local smoke test: same host, different ports.
# Real LAN test: set BO_1_HOST/BO_2_HOST/BO_3_HOST to M1/M2/M3 IPs.
BO_1_ID=bo-1
BO_1_HOST=192.168.0.10
BO_1_PORT=4001
BO_2_ID=bo-2
BO_2_HOST=192.168.0.10
BO_2_PORT=4002
BO_3_ID=bo-3
BO_3_HOST=192.168.0.10
BO_3_PORT=4003

# Per-replica start-bo.js values.
BO_ID=bo-1
BO_PORT=4001

# Postgres on M0. On BO machines, DB_HOST must point to M0.
DB_HOST=192.168.0.10
DB_PORT=5432
DB_USER=rsi
DB_PASSWORD=rsi
DB_NAME=criminals
DB_POOL_MAX=10

# Load test tuning
TARGET_RPS=2000
DURATION_SEC=30
VIRTUAL_CLIENTS=50
READ_WRITE_RATIO=0.9
SAMPLE_EVERY=200
DASHBOARD_INTERVAL_MS=500

# Logs
LOG_LEVEL=info
LOG_COLOR=true
ROUTING_STREAM=true
